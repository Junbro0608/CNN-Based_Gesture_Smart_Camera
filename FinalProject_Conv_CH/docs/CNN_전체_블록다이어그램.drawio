        <mxCell id="ext_weight" value="&lt;b&gt;외부 Weight Buffer&lt;/b&gt;&lt;br&gt;&lt;br&gt;비동기 Read&lt;br&gt;signed Weight: 8-bit&lt;br&gt;signed Bias: 32-bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
