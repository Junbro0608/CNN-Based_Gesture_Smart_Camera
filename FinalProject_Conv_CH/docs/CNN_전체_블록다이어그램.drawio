          <mxGeometry x="1010" y="720" width="280" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="sequence" value="&lt;b&gt;전체 처리 순서 및 Feature Map&lt;/b&gt;&lt;br&gt;입력 Bank A: 1×130×130 → Conv1+ReLU+Pool: 16×64×64 (Bank B) → Conv2+ReLU+Pool: 32×32×32 (Bank A)&lt;br&gt;→ Conv3+ReLU+Pool: 64×16×16 (Bank B) → Pool4: 64×8×8 (Bank A) → Pool5: 64×4×4 (Bank B, 총 1024개)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;strokeWidth=2;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
