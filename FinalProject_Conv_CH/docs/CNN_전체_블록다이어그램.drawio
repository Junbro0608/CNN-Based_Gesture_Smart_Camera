        </mxCell>

        <mxCell id="shift" value="&lt;b&gt;Shift_Buffer&lt;/b&gt;&lt;br&gt;&lt;br&gt;4×4 Tile 수집&lt;br&gt;3×3 Window 4개 생성&lt;br&gt;window_index = 00/01/10/11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
