        <mxCell id="scheduler" value="&lt;b&gt;CNN 상위 FSM / Scheduler&lt;/b&gt;&lt;br&gt;&lt;br&gt;IDLE → START_GROUP → RUN_GROUP&lt;br&gt;→ START_POOL4 → RUN_POOL4&lt;br&gt;→ START_POOL5 → RUN_POOL5 → DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
